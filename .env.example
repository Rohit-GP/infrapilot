# Copy this to .env in diagnostics-engine/, ai-reasoning/, and/or
# backend-orchestration/ and adjust as needed.
# python-dotenv loads whichever .env is in the current working directory.

# --- Redis Streams (diagnostics-engine, ai-reasoning) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=diagnostics:evidence
REDIS_CONSUMER_GROUP=reasoning-agents
REDIS_CONSUMER_NAME=reasoning-agent-1

# --- AI reasoning job-completion tuning (ai-reasoning) ---
REASONING_JOB_IDLE_TIMEOUT_S=15
REASONING_POLL_INTERVAL_S=1

# --- Postgres (backend-orchestration, ai-reasoning) ---
# Same database, used by both services - see docs/backend.md for who
# writes what.
DATABASE_URL=postgresql+psycopg2://infrapilot:infrapilot@localhost:5432/infrapilot

# --- JWT auth (backend-orchestration) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Diagnostics engine trigger (backend-orchestration) ---
# Path to the diagnostics-engine project directory and the python
# executable (its own venv) to run it with, since it's invoked as a
# subprocess rather than imported in-process.
DIAGNOSTICS_ENGINE_DIR=../diagnostics-engine
DIAGNOSTICS_ENGINE_PYTHON=python3
DIAGNOSTICS_ENGINE_TIMEOUT_S=60

# --- CORS (backend-orchestration) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
